{
  "manifest_version": 3,
  "name": "Lakbayon",
  "version": "1.1",
  "description": "A floating travel companion with chat, media, groups, shares and tools, available on every page.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-companion": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle the Lakbayon companion"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://vimeo.com/*",
    "https://www.instagram.com/*"
  ]
}